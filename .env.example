# Copy this file to .env.local (same folder as package.json), then restart `npm run dev`.
#
# VITE_API_URL=/api  -> the app talks to the real backend through its own address:
#                       - in development, Vite's dev server forwards /api (see vite.config.js)
#                       - on Netlify, the /api rule in public/_redirects does the same
#                       No CORS or cookie problems, because the browser only sees one site.
# VITE_API_URL empty -> the app uses its built-in mock server (demo mode).
#
VITE_API_URL=/api
